# Integration test environment (copy to tests/integration/.env and fill in).
#
# Credentials file (git-ignored):
#   tests/integration/.secrets/sa.json
#
PYNTERACTA_BASE_URL=
PYNTERACTA_BASE_PATH=/portal
PYNTERACTA_API_VERSION=2
PYNTERACTA_SERVICE_ACCOUNT_KEY=tests/integration/.secrets/sa.json
# Google OAuth2 auth (optional): a Google access token with minimum scope 'profile',
# belonging to a Google identity already linked to an Interacta user. Short-lived; never
# committed. See docs/authentication.md for how to obtain it.
PYNTERACTA_GOOGLE_OAUTH2_TOKEN=
PYNTERACTA_TEST_COMMUNITY_ID=
PYNTERACTA_TEST_USER_ID=
PYNTERACTA_TEST_POST_ID=
PYNTERACTA_TEST_CATALOG_ID=
PYNTERACTA_TEST_ATTACHMENT_ID=
